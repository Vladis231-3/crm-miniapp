APP_ENV=development
# Use a unique random value of at least 32 characters in production/staging.
APP_SECRET=
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=
TELEGRAM_DELIVERY_MODE=webhook
SYNC_TELEGRAM_WEBHOOK=true
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
# Production/staging defaults to 300 seconds and caps this value at 900.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=30
CRON_SECRET=
# Must be false in production/staging.
ALLOW_DEMO_SEED_DATA=true
RUN_EMBEDDED_BOT=false
ALLOW_INSECURE_CLIENT_AUTH=false
API_HOST=0.0.0.0
API_PORT=8000
# Maximum upload size in bytes (default: 10 MiB).
UPLOAD_MAX_BYTES=10485760
UPLOADS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
POSTGRES_URL=
DATABASE_SSLMODE=prefer
# JSON array; keep real Telegram IDs out of committed examples.
# PERMANENT_TELEGRAM_OWNERS=[{"id":"owner-config-1","login":"owner_config_1","telegram_id":"123456789","name":"Владелец"}]
