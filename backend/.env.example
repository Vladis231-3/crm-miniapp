APP_ENV=development
# Use a unique random value of at least 32 characters in production/staging.
APP_SECRET=
TELEGRAM_BOT_TOKEN=
WEBAPP_URL=
# URL обучающей версии минаппа (деплой training/frontend). Если пусто —
# кнопка «Открыть обучение» в /help ведёт на обычную CRM (WEBAPP_URL).
TRAINING_WEBAPP_URL=
TELEGRAM_DELIVERY_MODE=webhook
SYNC_TELEGRAM_WEBHOOK=true
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
# Session lifetime for Telegram initData (auth_date freshness). Default: 24h everywhere.
# Set a smaller value (e.g. 900) only if you want stricter replay protection.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=30
CRON_SECRET=
# Must be false in production/staging.
ALLOW_DEMO_SEED_DATA=true
RUN_EMBEDDED_BOT=false
ALLOW_INSECURE_CLIENT_AUTH=false
API_HOST=0.0.0.0
API_PORT=8000
# Maximum upload size in bytes (default: 10 MiB).
UPLOAD_MAX_BYTES=10485760
UPLOADS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
POSTGRES_URL=
DATABASE_SSLMODE=prefer
# JSON array; keep real Telegram IDs out of committed examples.
# PERMANENT_TELEGRAM_OWNERS=[{"id":"owner-config-1","login":"owner_config_1","telegram_id":"123456789","name":"Владелец"}]

# ── Google Calendar интеграция (бот -> Google) ──────────────────────────────
# OAuth-приложение: https://console.cloud.google.com/apis/credentials
# (нужны OAuth Client ID типа "Web application" + включённый Google Calendar API)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Публичный URL вашего бэкенда + путь callback (добавьте его в Authorized redirect URIs
# в Google Cloud Console). Например: https://api.example.com/api/owner/integrations/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Таймзона событий в календаре (IANA). По умолчанию Europe/Moscow.
GOOGLE_CALENDAR_TIMEZONE=Europe/Moscow
